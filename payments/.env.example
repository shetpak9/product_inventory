# Use this single Render secret instead of the individual Firebase fields.
# Set the complete JSON only in Render's environment-variable dashboard.
FIREBASE_SERVICE_ACCOUNT_JSON=<service-account-json-in-render>

# Alternatively, omit FIREBASE_SERVICE_ACCOUNT_JSON and set all four only in Render:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=<service-account-email>
# FIREBASE_PRIVATE_KEY=<private-key-in-render>
