PORT=3000
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_WEBHOOK_SECRET=whsk_...
PAYMENT_RETURN_BASE_URL=https://your-firebase-hosting.web.app
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Use this single Render secret instead of the individual Firebase fields.
# Keep the JSON on one line and never commit a service-account file.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Alternatively, omit FIREBASE_SERVICE_ACCOUNT_JSON and set all four:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
